<?xml version="1.0"?>
<package format="3">
  <name>drone_control</name>
  <version>0.2.0</version>
  <description>PX4/MAVROS offboard flight controller and TF bridge.</description>
  <maintainer email="harshasekar.09@gmail.com">Harshavardhan Coimbatore Sekar</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
