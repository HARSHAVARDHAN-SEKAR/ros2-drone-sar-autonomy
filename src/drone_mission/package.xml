  <version>0.2.0</version>
  <description>High-level SAR mission state machine for the ROS 2 PX4 drone.</description>
  <maintainer email="harshasekar.09@gmail.com">Harshavardhan Coimbatore Sekar</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
