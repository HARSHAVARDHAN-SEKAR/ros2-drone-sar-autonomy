<?xml version="1.0"?>
<package format="3">
  <name>drone_perception</name>
  <version>0.2.0</version>
  <description>Depth mapping, victim-candidate detection and safety monitoring.</description>
  <maintainer email="harshasekar.09@gmail.com">Harshavardhan Coimbatore Sekar</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>drone_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
