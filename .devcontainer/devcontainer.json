{
  "name": "ROS 2 Drone SAR Autonomy",
  "dockerComposeFile": "../compose.yaml",
  "service": "ros",
  "workspaceFolder": "/workspace",
  "runServices": ["ros"],
  "shutdownAction": "stopCompose",
  "remoteUser": "rosdev",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
